[Unit]
Description=Selected laptop power optimizations
After=power-profiles-daemon.service NetworkManager.service
Wants=power-profiles-daemon.service

[Service]
Type=simple
ExecStart=/usr/lib/omarchy-t2/power-optimizer
Restart=on-failure
RestartSec=2
RuntimeDirectory=power-optimizer
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
TimeoutStopSec=5

[Install]
WantedBy=graphical.target
